[Unit]
Description=v2rayA cached-node health and failover
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/v2raya-failover/v2raya_failover.py
TimeoutStartSec=240
KillMode=control-group
PrivateTmp=true
